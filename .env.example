# Local PostgreSQL (adjust user, password, db name)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelancer_marketing?schema=public"
# Hosted DBs (e.g. Neon): use sslmode=verify-full to avoid pg SSL deprecation warnings
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=verify-full"

# Clerk (https://dashboard.clerk.com) — keys for your instance
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# After sign-in / sign-up Clerk always sends users here (mirrors ClerkProvider + button props).
# You can set these in Clerk Dashboard → Paths instead if you prefer.
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/dashboard"

# --- Vercel production (set in Project → Settings → Environment Variables) ---
# DATABASE_URL          — Neon connection string (Production + Preview)
# NEXT_PUBLIC_CLERK_*   — use pk_live_ / sk_live_ keys for production, or same test keys for previews
# Clerk Dashboard → Configure → Domains: add https://your-app.vercel.app
# After first deploy, push schema to prod DB: DATABASE_URL="..." npm run db:push
